  "scripts": {
    "build": "tsc && vite build && chmod +x dist/cli.js",
    "lint": "eslint . --ext .ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "chalk": "^5.4.1",
