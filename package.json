{
  "name": "scriptshifter",
  "description": "Automatically convert Vue components from Options API to <script setup>",
  "version": "1.0.1",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "author": {
    "name": "UnrefinedBrain",
    "url": "https://github.com/UnrefinedBrain"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UnrefinedBrain/scriptshifter.git"
  },
  "keywords": [
    "vue",
    "script setup",
    "composition api",
    "options",
    "codemod",
    "converter"
  ],
  "type": "module",
  "bin": {
    "scriptshifter": "dist/cli.js"
